{
  "name": "@bonakodo/svelte-check",
  "version": "0.1.0",
  "exports": {
    ".": "./main.ts",
    "./cli": "./cli.ts",
    "./transform": "./src/transform/mod.ts"
  },
  "exclude": [
    "work",
    "outputs",
    "node_modules",
    "tests/fixtures"
  ],
  "imports": {
    "svelte": "npm:svelte@5.57.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/jsonc": "jsr:@std/jsonc@1",
    "@jridgewell/trace-mapping": "npm:@jridgewell/trace-mapping@0.3.31"
  },
  "tasks": {
    "check": "deno fmt --check && deno task lint && deno check main.ts main_test.ts cli.ts mod.ts src/ tests/",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env main_test.ts tests/",
    "lint": "deno lint main.ts main_test.ts cli.ts mod.ts src/ tests/",
    "fmt": "deno fmt",
    "svelte-check": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net cli.ts",
    "publish:check": "deno task check && deno task test && deno publish --dry-run"
  },
  "fmt": {
    "exclude": [
      "work",
      "tests/fixtures"
    ]
  },
  "lint": {
    "exclude": [
      "work",
      "tests/fixtures",
      "outputs"
    ]
  },
  "test": {
    "exclude": [
      "work",
      "tests/fixtures",
      "outputs"
    ]
  },
  "license": "MIT",
  "publish": {
    "include": [
      "deno.json",
      "deno.lock",
      "main.ts",
      "mod.ts",
      "cli.ts",
      "src/",
      "README.md",
      "LICENSE"
    ]
  }
}
